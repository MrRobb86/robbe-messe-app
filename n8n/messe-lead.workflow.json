    {
      "parameters": {
        "jsCode": "// Visitenkarten-Bilder (JPEG-dataURLs) als Binaerdaten fuer Mail-Anhang\n// aufbereiten und den Vision-Prompt bauen.\nconst body = $json.body;\nconst binary = {};\nconst content = [{\n  type: 'text',\n  text: 'Lies diese Visitenkarte(n) und antworte NUR mit JSON: ' +\n    '{\"name\":\"\",\"firma\":\"\",\"position\":\"\",\"email\":\"\",\"telefon\":\"\",\"website\":\"\",\"adresse\":\"\",\"sonstiges\":\"\"}. ' +\n    'Felder, die nicht lesbar sind, leer lassen. Keine Erklaerungen.'\n}];\nif (body.images?.front) {\n  binary.front = { data: body.images.front.split(',')[1], mimeType: 'image/jpeg', fileName: 'visitenkarte-vorderseite.jpg' };\n  content.push({ type: 'image_url', image_url: { url: body.images.front } });\n}\nif (body.images?.back) {\n  binary.back = { data: body.images.back.split(',')[1], mimeType: 'image/jpeg', fileName: 'visitenkarte-rueckseite.jpg' };\n  content.push({ type: 'image_url', image_url: { url: body.images.back } });\n}\nconst openaiBody = {\n  model: 'gpt-4o-mini',\n  response_format: { type: 'json_object' },\n  messages: [{ role: 'user', content }],\n  max_tokens: 400,\n};\nreturn [{ json: { ...$json, openaiBody }, binary }];"
      },
      "id": "code-karte",
      "name": "Karte: Bilder & Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [620, 420]
    },
