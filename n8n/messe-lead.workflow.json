    {
      "parameters": {
        "jsCode": "// Dedup ueber die clientseitige leadId (Offline-Queue der Kiosk-App darf\n// gefahrlos mehrfach senden). Merker liegt im Workflow-Static-Data.\nconst sd = $getWorkflowStaticData('global');\nsd.seen = sd.seen || {};\nconst id = $json.body.leadId || 'ohne-id';\nconst duplicate = Boolean(sd.seen[id]);\nsd.seen[id] = Date.now();\n// Aufraeumen: aelter als 30 Tage raus.\nconst cutoff = Date.now() - 30 * 24 * 60 * 60 * 1000;\nfor (const [k, t] of Object.entries(sd.seen)) if (t < cutoff) delete sd.seen[k];\nreturn [{ json: { ...$json, duplicate } }];"
      },
      "id": "code-dedup",
      "name": "Schon verarbeitet?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [840, 100]
