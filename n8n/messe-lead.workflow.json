      "parameters": {
        "jsCode": "// JSON-Antwort des Vision-Modells parsen; Binaerdaten (Kartenfotos)\n// aus dem Vorbereitungs-Node wieder anhaengen (fuer den Mail-Anhang).\nlet daten = {};\ntry {\n  daten = JSON.parse($json.choices?.[0]?.message?.content || '{}');\n} catch (e) {\n  daten = { sonstiges: 'KI-Antwort nicht lesbar' };\n}\nreturn [{ json: { daten }, binary: $('Karte: Bilder & Prompt').first().binary }];"
      },
